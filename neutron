#!/usr/bin/env python3
"""Run Windows Steam games on macOS through Wine, bridged to the native Steam client."""

import argparse
import hashlib
import io
import json
import os
import shlex
import shutil
import struct
import subprocess
import sys
import urllib.request
import zipfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent
DIST = ROOT / "dist"
BACKENDS = ("dxmt", "wined3d")
STEAM_DIR = Path.home() / "Library/Application Support/Steam"
STEAM_CLIENT_DIR = STEAM_DIR / "Steam.AppBundle/Steam/Contents/MacOS"
STEAM_APPINFO = STEAM_DIR / "appcache/appinfo.vdf"
NEUTRON = Path.home() / "Library/Application Support/Neutron"
PREFIXES = NEUTRON / "prefixes"
LIBRARY = NEUTRON / "library"
CONFIG = NEUTRON / "config.json"
DEPOTDOWNLOADER = NEUTRON / "depotdownloader/DepotDownloader"
DEPOTDOWNLOADER_URL = "https://github.com/SteamRE/DepotDownloader/releases/download/DepotDownloader_3.4.0/DepotDownloader-macos-arm64.zip"
DEPOTDOWNLOADER_SHA256 = "60e80c7c496f3f9a079cd3c62036b35d088c27bc0149baf38f009eb57a52f6a5"
PFX_STEAM_DIR = "drive_c/Program Files (x86)/Steam"

STEAM_REG = r"""Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\Software\Valve\Steam]
"SteamPath"="C:\\Program Files (x86)\\Steam"
"SteamExe"="C:\\Program Files (x86)\\Steam\\steam.exe"

[HKEY_CURRENT_USER\Software\Valve\Steam\ActiveProcess]
"SteamClientDll"="C:\\Program Files (x86)\\Steam\\steamclient.dll"
"SteamClientDll64"="C:\\Program Files (x86)\\Steam\\steamclient64.dll"
"SteamPath"="C:\\Program Files (x86)\\Steam"

[HKEY_LOCAL_MACHINE\Software\Wow6432Node\Valve\Steam]
"InstallPath"="C:\\Program Files (x86)\\Steam"
"""


def runtime(backend):
    path = DIST / "runtimes" / backend
    if not path.is_dir():
        sys.exit(f"neutron: runtime {path} missing, run scripts/build.sh")
    return path


def wine_env(prefix, backend, appid):
    env = dict(os.environ)
    env["WINEPREFIX"] = str(prefix)
    env.setdefault("WINEDEBUG", "-all")
    env["STEAM_COMPAT_CLIENT_INSTALL_PATH"] = str(STEAM_CLIENT_DIR)
    if appid:
        env["SteamAppId"] = env["SteamGameId"] = str(appid)
    return env


def setup_prefix(prefix, backend, env):
    wine = runtime(backend) / "bin/wine"
    stamp_file = prefix / ".neutron"
    stamp = "\n".join([backend, str((runtime(backend) / "lib/wine/x86_64-unix/lsteamclient.so").stat().st_mtime_ns)])
    if stamp_file.exists() and stamp_file.read_text() == stamp:
        return

    prefix.mkdir(parents=True, exist_ok=True)
    # exits nonzero on harmless setupapi warnings
    subprocess.run([wine, "wineboot", "-u"], env=env, capture_output=True)
    if not (prefix / "drive_c/windows/system32/lsteamclient.dll").exists():
        sys.exit(f"neutron: wineboot failed to set up {prefix}")

    steam_dir = prefix / PFX_STEAM_DIR
    steam_dir.mkdir(parents=True, exist_ok=True)
    for name in ("steamclient.dll", "steamclient64.dll"):
        shutil.copyfile(DIST / "steam" / name, steam_dir / name)

    reg = prefix / "neutron-steam.reg"
    reg.write_text(STEAM_REG)
    subprocess.run([wine, "regedit", "/S", str(reg)], env=env, check=True, capture_output=True)
    subprocess.run([runtime(backend) / "bin/wineserver", "-w"], env=env, check=True)
    stamp_file.write_text(stamp)


def _cstr(data, pos):
    end = data.index(b"\0", pos)
    return data[pos:end].decode("utf-8", "replace"), end + 1


def parse_binary_vdf(data, pos, strings):
    """Parse binary KeyValues; keys are string-table indices when strings is given (appinfo v29)."""
    obj = {}
    while True:
        kind = data[pos]
        pos += 1
        if kind == 0x08:
            return obj, pos
        if strings is None:
            key, pos = _cstr(data, pos)
        else:
            key = strings[struct.unpack_from("<I", data, pos)[0]]
            pos += 4
        if kind == 0x00:
            obj[key], pos = parse_binary_vdf(data, pos, strings)
        elif kind == 0x01:
            obj[key], pos = _cstr(data, pos)
        elif kind in (0x02, 0x04, 0x06):
            obj[key] = struct.unpack_from("<i", data, pos)[0]
            pos += 4
        elif kind == 0x03:
            obj[key] = struct.unpack_from("<f", data, pos)[0]
            pos += 4
        elif kind in (0x07, 0x0A):
            obj[key] = struct.unpack_from("<q", data, pos)[0]
            pos += 8
        else:
            raise ValueError(f"unknown KeyValues type {kind:#x} at {pos - 1}")


def read_appinfo(appid, path=STEAM_APPINFO):
    """Read one app's info from the Steam client's appinfo.vdf cache (v28/v29)."""
    data = path.read_bytes()
    magic = struct.unpack_from("<I", data, 0)[0]
    if magic == 0x07564429:
        table = struct.unpack_from("<q", data, 8)[0]
        count = struct.unpack_from("<I", data, table)[0]
        strings, p = [], table + 4
        for _ in range(count):
            string, p = _cstr(data, p)
            strings.append(string)
        pos = 16
    elif magic == 0x07564428:
        strings, pos = None, 8
    else:
        sys.exit(f"neutron: unsupported appinfo.vdf version {magic:#x}")

    while True:
        entry_id, size = struct.unpack_from("<II", data, pos)
        if entry_id == 0:
            return None
        if entry_id == appid:
            # skip info state, last updated, PICS token, text SHA-1, change number, binary SHA-1
            info = parse_binary_vdf(data, pos + 8 + 60, strings)[0]
            return info.get("appinfo", info)
        pos += 8 + size


def launch_entry(appinfo):
    """Pick the launch option Steam would use on Windows, preferring 64-bit."""
    def usable(entry):
        config = entry.get("config", {})
        return (entry.get("executable")
                and "windows" in config.get("oslist", "windows")
                and entry.get("type", "default") in ("default", "none")
                and not config.get("betakey"))

    entries = [e for e in appinfo.get("config", {}).get("launch", {}).values() if usable(e)]
    entries.sort(key=lambda e: str(e.get("config", {}).get("osarch")) != "64")
    return entries[0] if entries else None


def load_config():
    return json.loads(CONFIG.read_text()) if CONFIG.exists() else {}


def depotdownloader():
    if not DEPOTDOWNLOADER.exists():
        with urllib.request.urlopen(DEPOTDOWNLOADER_URL) as resp:
            archive = resp.read()
        if hashlib.sha256(archive).hexdigest() != DEPOTDOWNLOADER_SHA256:
            sys.exit("neutron: DepotDownloader checksum mismatch")
        DEPOTDOWNLOADER.parent.mkdir(parents=True, exist_ok=True)
        zipfile.ZipFile(io.BytesIO(archive)).extract(DEPOTDOWNLOADER.name, DEPOTDOWNLOADER.parent)
        DEPOTDOWNLOADER.chmod(0o755)
    return DEPOTDOWNLOADER


def cmd_install(args):
    config = load_config()
    user = args.user or config.get("user")
    if not user:
        sys.exit("neutron: pass --user <steam-user> the first time")

    appinfo = read_appinfo(args.appid)
    if not appinfo:
        sys.exit(f"neutron: Steam has no info for {args.appid} yet, open it in your Steam library first")
    entry = launch_entry(appinfo)
    if not entry:
        sys.exit(f"neutron: no Windows launch option found for {args.appid}")

    install_dir = LIBRARY / str(args.appid)
    install_dir.mkdir(parents=True, exist_ok=True)
    osarch = "32" if str(entry.get("config", {}).get("osarch")) == "32" else "64"
    cmd = [str(depotdownloader()), "-app", str(args.appid), "-os", "windows", "-osarch", osarch,
           "-dir", str(install_dir), "-username", user, "-remember-password", "-validate"]
    if subprocess.run(cmd, cwd=DEPOTDOWNLOADER.parent).returncode:
        sys.exit(f"neutron: download of {args.appid} failed")

    (install_dir / "neutron-appinfo.json").write_text(json.dumps(appinfo, indent=2))
    NEUTRON.mkdir(parents=True, exist_ok=True)
    CONFIG.write_text(json.dumps({**config, "user": user}, indent=2))
    print(f"installed {appinfo.get('common', {}).get('name', args.appid)} to {install_dir}")


def resolve_launch(appid):
    install_dir = LIBRARY / str(appid)
    info_file = install_dir / "neutron-appinfo.json"
    if not info_file.exists():
        sys.exit(f"neutron: {appid} is not installed, run `neutron install {appid}`")
    entry = launch_entry(json.loads(info_file.read_text()))
    exe = install_dir / entry["executable"].replace("\\", "/")
    workdir = install_dir / entry["workingdir"].replace("\\", "/") if entry.get("workingdir") else exe.parent
    return exe, workdir, shlex.split(entry.get("arguments", ""))


def cmd_run(args):
    if args.exe:
        exe, launch_args = Path(args.exe).resolve(), []
        workdir = exe.parent
    elif args.appid:
        exe, workdir, launch_args = resolve_launch(args.appid)
    else:
        sys.exit("neutron: pass an exe or --appid")

    prefix = Path(args.prefix).resolve() if args.prefix else PREFIXES / (str(args.appid) if args.appid else "default")
    env = wine_env(prefix, args.backend, args.appid)
    setup_prefix(prefix, args.backend, env)
    os.chdir(workdir)
    wine = str(runtime(args.backend) / "bin/wine")
    os.execve(wine, [wine, "steam.exe", "Z:" + str(exe).replace("/", "\\"), *launch_args, *args.args], env)


def cmd_wine(args):
    prefix = Path(args.prefix).resolve() if args.prefix else PREFIXES / "default"
    env = wine_env(prefix, args.backend, None)
    setup_prefix(prefix, args.backend, env)
    wine = str(runtime(args.backend) / "bin/wine")
    os.execve(wine, [wine, *args.args], env)


def main():
    parser = argparse.ArgumentParser(prog="neutron")
    sub = parser.add_subparsers(required=True)

    install = sub.add_parser("install", help="download a game's Windows build")
    install.add_argument("appid", type=int)
    install.add_argument("--user", help="Steam account; prompts for login once, remembered afterwards")
    install.set_defaults(func=cmd_install)

    run = sub.add_parser("run", help="launch an installed game, or an exe, through the Steam bridge")
    run.add_argument("--appid", type=int, help="Steam AppID (enables Steamworks)")
    run.add_argument("--backend", choices=BACKENDS, default="dxmt")
    run.add_argument("--prefix")
    run.add_argument("exe", nargs="?")
    run.add_argument("args", nargs=argparse.REMAINDER)
    run.set_defaults(func=cmd_run)

    wine = sub.add_parser("wine", help="run a raw wine command in a prefix")
    wine.add_argument("--backend", choices=BACKENDS, default="dxmt")
    wine.add_argument("--prefix")
    wine.add_argument("args", nargs=argparse.REMAINDER)
    wine.set_defaults(func=cmd_wine)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
