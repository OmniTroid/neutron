     });
 }
+
+/* Full-size client view for DXMT, which predates lazily created client surfaces. */
+WineContentView *macdrv_create_dxmt_client_view(WineWindow *window)
+{
+@autoreleasepool
+{
+    __block WineContentView *view;
+
+    OnMainThread(^{
+        NSView *content = [window contentView];
+        view = [[WineContentView alloc] initWithFrame:[content bounds]];
+        [view setAutoresizingMask:NSViewWidthSizable | NSViewHeightSizable];
+        [content addSubview:view];
+    });
+    return view;
+}
+}
diff -ruN a/winemac.drv/dxmt_exports.c b/winemac.drv/dxmt_exports.c
--- a/winemac.drv/dxmt_exports.c	1970-01-01 01:00:00
+++ b/winemac.drv/dxmt_exports.c	2026-10-26 15:16:35
@@ -0,0 +1,82 @@
+/* CrossOver-compatible macdrv_functions table, looked up by DXMT's winemetal.so. */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+#include "macdrv.h"
+
+struct dxmt_win_data
+{
+    HWND hwnd;
+    WineWindow *cocoa_window;
+    WineContentView *cocoa_view;
+    WineContentView *client_cocoa_view;
+    struct macdrv_win_data *data;
+};
+
+struct macdrv_functions_t
+{
+    void (*macdrv_init_display_devices)(BOOL);
+    struct dxmt_win_data *(*get_win_data)(HWND hwnd);
+    void (*release_win_data)(struct dxmt_win_data *data);
+    WineWindow *(*macdrv_get_cocoa_window)(HWND hwnd, BOOL require_on_screen);
+    id_MTLDevice (*macdrv_create_metal_device)(void);
+    void (*macdrv_release_metal_device)(id_MTLDevice d);
+    WineMetalView *(*macdrv_view_create_metal_view)(WineContentView *v, id_MTLDevice d);
+    CAMetalLayer *(*macdrv_view_get_metal_layer)(WineMetalView *v);
+    void (*macdrv_view_release_metal_view)(WineMetalView *v);
+    void (*on_main_thread)(void *block);
+};
+
+extern WineContentView *macdrv_create_dxmt_client_view(WineWindow *window);
+
+static struct dxmt_win_data *dxmt_get_win_data(HWND hwnd)
+{
+    struct macdrv_win_data *data = get_win_data(hwnd);
+    struct dxmt_win_data *ret;
+    WineWindow *window;
+    WineContentView *view;
+
+    if (!data) return NULL;
+    if (!data->client_view && (window = data->cocoa_window))
+    {
+        release_win_data(data);
+        view = macdrv_create_dxmt_client_view(window);
+        if (!(data = get_win_data(hwnd))) return NULL;
+        if (!data->client_view) data->client_view = view;
+        else macdrv_dispose_view(view);
+    }
+    if (!(ret = calloc(1, sizeof(*ret))))
+    {
+        release_win_data(data);
+        return NULL;
+    }
+    ret->hwnd = data->hwnd;
+    ret->cocoa_window = data->cocoa_window;
+    ret->cocoa_view = ret->client_cocoa_view = data->client_view;
+    ret->data = data;
+    return ret;
+}
+
+static void dxmt_release_win_data(struct dxmt_win_data *data)
+{
+    if (!data) return;
+    release_win_data(data->data);
+    free(data);
+}
+
+__attribute__((visibility("default"))) const struct macdrv_functions_t macdrv_functions =
+{
+    NULL,
+    dxmt_get_win_data,
+    dxmt_release_win_data,
+    macdrv_get_cocoa_window,
+    macdrv_create_metal_device,
+    macdrv_release_metal_device,
+    macdrv_view_create_metal_view,
+    macdrv_view_get_metal_layer,
+    macdrv_view_release_metal_view,
+    NULL,
+};
